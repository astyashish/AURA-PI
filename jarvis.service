[Unit]
Description=JARVIS-PI Local AI Assistant
After=network.target ollama.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/jarvis-pi
ExecStart=/home/pi/jarvis-pi/venv/bin/python main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
