# Jarvis-Pi Configuration
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=qwen2.5:0.5b
VISION_MODEL=llava:7b
FAST_MODEL=qwen2.5:0.5b

# Web Server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=jarvis-secret-change-this

# Hardware
ENABLE_GPIO=true
ENABLE_CAMERA=true
ENABLE_VOICE=true

# GPIO Pins (BCM numbering)
GPIO_LIVING_ROOM=17
GPIO_BEDROOM=27
GPIO_STATUS_BLUE=22
GPIO_STATUS_GREEN=23
GPIO_CAMERA_LED=24

# Voice Settings
WAKE_WORD=jarvis
VOICE_MODEL_PATH=./models/voices/en_US-lessac-medium.onnx
PIPER_PATH=/usr/local/bin/piper

# Vosk Model
VOSK_MODEL_PATH=./models/vosk-model-small-en-us-0.15
